# Public env vars (safe to expose in browser)

# Google Analytics 4 — get from https://analytics.google.com (looks like G-XXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Google Tag Manager — get from https://tagmanager.google.com (looks like GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity — get from https://clarity.microsoft.com (project ID, e.g. abc123def4)
NEXT_PUBLIC_CLARITY_ID=

# ============================================================================
# Server-only env vars (never exposed to the browser)
# ============================================================================

# Anthropic API key — powers the "Ask Jose" chat agent at /api/chat.
# Get one from https://console.anthropic.com/settings/keys (looks like sk-ant-api03-...)
# When deploying, also add this to Vercel project env vars (Production scope).
ANTHROPIC_API_KEY=
