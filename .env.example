# Public env vars (safe to expose in browser)

# Google Analytics 4 — get from https://analytics.google.com (looks like G-XXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Google Tag Manager — get from https://tagmanager.google.com (looks like GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity — get from https://clarity.microsoft.com (project ID, e.g. abc123def4)
NEXT_PUBLIC_CLARITY_ID=
